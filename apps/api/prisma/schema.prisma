// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model - for admin authentication (optional, can be removed if not needed)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  posts     Post[]

  @@map("users")
}

// Resume model - singleton for single resume management
model Resume {
  id        String   @id @default("main")
  content   Json     // Full resume data (JSON)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("resumes")
}

// Portfolio model - singleton for single portfolio management
model Portfolio {
  id        String   @id @default("main")
  content   Json     // Full portfolio data (JSON)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("portfolios")
}

// Post model - for blog
model Post {
  id         Int      @id @default(autoincrement())
  authorId   String   @map("author_id")
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  slug       String   @unique
  content    String   // Markdown content
  excerpt    String?
  coverImage String?  @map("cover_image")
  published  Boolean  @default(false)
  viewCount  Int      @default(0) @map("view_count")
  tags       Tag[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([authorId])
  @@index([slug])
  @@index([published])
  @@map("posts")
}

// Tag model - for blog categorization
model Tag {
  id    String @id @default(uuid())
  name  String @unique
  posts Post[]

  @@map("tags")
}

// ShareLink model - for shareable resume/portfolio links
model ShareLink {
  id          String    @id @default(uuid())
  slug        String    @unique
  type        ShareType
  label       String?
  active      Boolean   @default(true)
  viewCount   Int       @default(0) @map("view_count")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([slug])
  @@index([type])
  @@map("share_links")
}

enum ShareType {
  RESUME
  PORTFOLIO
}

// Role enum
enum Role {
  USER
  ADMIN
}
